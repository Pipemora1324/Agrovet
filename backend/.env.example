# Copiar a .env y ajustar. Estos valores son solo de ejemplo para el docker-compose local;
# en un servidor real se usan credenciales propias y un JWT_SECRET generado al azar.

# PostgreSQL 15 (contenedor "db" del docker-compose)
POSTGRES_DB=agrovet
POSTGRES_USER=agrovet
POSTGRES_PASSWORD=agrovet_dev
# Puerto del equipo donde se publica la base (cámbielo si ya usa el 5432)
DB_HOST_PORT=5432

# Conexión del backend a la base cuando se ejecuta fuera de Docker (./mvnw spring-boot:run).
# Dentro del docker-compose la URL apunta al contenedor "db" automáticamente.
DB_URL=jdbc:postgresql://localhost:5432/agrovet
DB_USERNAME=agrovet
DB_PASSWORD=agrovet_dev

# JWT: secreto de al menos 32 bytes en Base64 (por ejemplo: openssl rand -base64 48)
JWT_SECRET=cambia-este-valor-por-uno-aleatorio
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P14D

# Orígenes permitidos por CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Correo saliente (códigos de verificación y de recuperación de contraseña).
# En el docker-compose, si se dejan comentadas, los correos van a Mailpit (http://localhost:8025).
# Para un servidor real, use el SMTP de su proveedor con TLS:
# SMTP_HOST=smtp.su-proveedor.com
# SMTP_PORT=587
# SMTP_USERNAME=usuario
# SMTP_PASSWORD=clave
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# MAIL_FROM=AgroVet <no-responder@su-dominio.com>
# Fuera de Docker (./mvnw spring-boot:run) con Mailpit encendido:
# SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_AUTH=false  SMTP_STARTTLS=false

# Carpeta de las fotos de las vacas (en el docker-compose es un volumen en /app/data/photos)
# Fuera de Docker:
# PHOTO_STORAGE_DIR=./data/photos
