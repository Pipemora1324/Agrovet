%% Despliegue: local actual (docker-compose.yml), demostración en Render (render.yaml)
%% y objetivo en una VPS (docker-compose.prod.yml + Caddy, aún no desplegado)
flowchart LR
  subgraph Local["Local actual"]
    direction TB
    EMU["Emulador Android<br/>API_BASE_URL: http a 10.0.2.2, puerto 8080"]
    USB["Celular o tableta por USB<br/>adb reverse 8080 y 8025<br/>API_BASE_URL: http a localhost, puerto 8080"]
    subgraph DC["docker-compose.yml"]
      BE1["backend<br/>puerto 8080 publicado"]
      DB1[("db: postgres:15-alpine<br/>127.0.0.1:DB_HOST_PORT")]
      MP["mailpit v1.32.0<br/>UI 8025 · SMTP 1025"]
      V1[("volúmenes pgdata y photos")]
    end
    EMU -- "HTTP (solo debug)" --> BE1
    USB -- "HTTP (solo debug)" --> BE1
    BE1 --> DB1
    BE1 -- "MAIL_USERNAME vacío" --> MP
    DB1 --- V1
  end

  EXT["Servicios externos<br/>Gmail SMTP 587 con STARTTLS<br/>API de Gemini"]
  BE1 -. "correo si MAIL_* tiene valor<br/>Gemini con GEMINI_API_KEY" .-> EXT

  subgraph Render["Demostración en Render (render.yaml, plan gratuito)"]
    direction TB
    RAPI["agrovet-api · servicio web Docker<br/>backend/Dockerfile · 512 MB · región Virginia<br/>SPRING_PROFILES_ACTIVE=prod · JAVA_TOOL_OPTIONS ajustado<br/>health: /actuator/health/readiness<br/>se duerme sin uso (≈ 90 s en despertar)"]
    RDB[("agrovet-db · PostgreSQL 15 (plan gratuito)<br/>vence a los 30 días")]
    REPH[("Disco efímero<br/>fotos en PHOTO_STORAGE_DIR:<br/>se pierden al dormir o redesplegar")]
    NOMAIL["Sin SMTP real: el plan gratuito lo bloquea<br/>cuentas nuevas se verifican a mano<br/>(verify_account.ps1)<br/>GEMINI_API_KEY se pide al crear el Blueprint"]
    RAPI -- "DATABASE_URL interna (fromDatabase)<br/>→ DatabaseUrlEnvironmentPostProcessor" --> RDB
    RAPI --- REPH
    RAPI -.- NOMAIL
  end

  DEMO["APK de demostración<br/>API_BASE_URL: https://&lt;servicio&gt;.onrender.com<br/>DEMO_MODE=true (también entra sin servidor)<br/>build_demo_apk.ps1"]
  DEMO -- HTTPS --> RAPI
  RAPI -- "Gemini" --> EXT
  SEEDS["seed_demo.ps1 (desde el PC)<br/>usuario de demostración y 6 vacas sintéticas<br/>por la dirección externa de la base"]
  SEEDS -. "una vez" .-> RDB

  subgraph Prod["Objetivo en una VPS (aún no desplegado)"]
    direction TB
    CAD["docker-compose.prod.yml<br/>caddy:2.8.4-alpine<br/>80 / 443 · HTTPS automático (Let's Encrypt)<br/>solo /api/* y /actuator/health*"]
    BE2["backend · SPRING_PROFILES_ACTIVE=prod<br/>Swagger apagado · solo expose 8080<br/>healthcheck /actuator/health/readiness"]
    DB2[("db: postgres:15-alpine<br/>sin puertos publicados")]
    V2[("volúmenes pgdata, photos,<br/>caddy_data, caddy_config")]
    CAD --> BE2 --> DB2
    DB2 --- V2
  end

  APK["App release<br/>API_BASE_URL: https a AGROVET_DOMAIN<br/>(solo HTTPS)"]
  APK -- HTTPS --> CAD
  BE2 -- "SMTP real obligatorio<br/>Gemini con GEMINI_API_KEY" --> EXT
