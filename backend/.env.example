# Copiar a .env y ajustar. Estos valores son solo de ejemplo para el docker-compose local;
# en un servidor real se usan credenciales propias y un JWT_SECRET generado al azar.

# PostgreSQL 15 (contenedor "db" del docker-compose)
POSTGRES_DB=agrovet
POSTGRES_USER=agrovet
POSTGRES_PASSWORD=agrovet_dev
# Puerto del equipo donde se publica la base (cámbielo si ya usa el 5432)
DB_HOST_PORT=5432

# Conexión del backend a la base cuando se ejecuta fuera de Docker (./mvnw spring-boot:run).
# Dentro del docker-compose la URL apunta al contenedor "db" automáticamente.
DB_URL=jdbc:postgresql://localhost:5432/agrovet
DB_USERNAME=agrovet
DB_PASSWORD=agrovet_dev

# JWT: secreto de al menos 32 bytes en Base64 (por ejemplo: openssl rand -base64 48)
JWT_SECRET=cambia-este-valor-por-uno-aleatorio
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P14D

# Orígenes permitidos por CORS, separados por coma (sin '*'). La app Android no lo necesita.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Solo en el servidor (docker-compose.prod.yml): dominio con HTTPS que atiende Caddy.
# El DNS del dominio debe apuntar a la IP del servidor.
# AGROVET_DOMAIN=api.su-dominio.co

# Correo saliente (códigos de verificación y de recuperación de contraseña).
# Si MAIL_USERNAME y MAIL_PASSWORD quedan vacíos, los correos van a Mailpit (http://localhost:8025).
# Si tienen valor, se envían de verdad por SMTP con STARTTLS.
# Gmail con contraseña de aplicación (requiere verificación en dos pasos).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Pega aquí la contraseña de aplicación de 16 caracteres, sin espacios.
MAIL_PASSWORD=
# Remitente. Vacío = la misma cuenta de MAIL_USERNAME (Gmail no deja usar otra).
MAIL_FROM=

# Carpeta de las fotos de las vacas (en el docker-compose es un volumen en /app/data/photos)
# Fuera de Docker:
# PHOTO_STORAGE_DIR=./data/photos

# Asistente con IA (Gemini). Sin clave, el asistente queda apagado y la app muestra consejos fijos.
# Pega aquí tu clave de Gemini (Google AI Studio). No la subas al repositorio.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ASSISTANT_MAX_PER_HOUR=20
# ASSISTANT_MAX_PER_DAY=60
